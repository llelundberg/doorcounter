[Unit]
Description=DoorCounter - shared people counter
After=network.target

[Service]
ExecStart=/usr/bin/node /srv/www/mumindalen/doorcounter/server.js
WorkingDirectory=/srv/www/mumindalen/doorcounter
User=kalle
Environment=PORT=8083
Environment=HOST=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
